FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      transportProperties;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

transportModel Newtonian;

// Laminar viscosity
nu              1.471e-05; // rho = 1.22 kg/m3 @ TRef.

// Thermal & mass expansion coefficient
beta            3.457432e-03; // @ TRef, for an ideal gas in the Boussinesq approximation, β = 1/TRef.
betaSh          0.60782;     

// Reference potential temperature (K) & specific humidity (kg/kg)
TRef            289.232; // surface temperature at IC, interpolated from 0/T: {12.5, 289.1929983716404},{37.5, 289.11455942665737}
shRef           0.009190666329739507; // surface specific humidity at IC, interpolated from 0/sh: {12.5, 0.009130094115766754},{37.5, 0.009008949687821247},
// Laminar Prandtl & Schmidt number
Pr              0.7;
Sch             0.66;

// Turbulent Prandtl & Schmidt number
Prt             0.7;
Scht            0.7;

