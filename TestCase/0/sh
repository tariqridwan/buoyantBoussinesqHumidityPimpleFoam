        {
            // Handle heights below minimum data point
            if (z <= profileData.first().first()) 
                return profileData.first().second();
            
            // Handle heights above maximum data point  
            if (z >= profileData.last().first()) 
                return profileData.last().second();
                
            // Find the interval that contains this z-value
            for (label i = 0; i < profileData.size() - 1; ++i)
            {
                if (z >= profileData[i].first() && z <= profileData[i+1].first())
                {
                    scalar z1 = profileData[i].first();
                    scalar z2 = profileData[i+1].first();
                    scalar sh1 = profileData[i].second();
                    scalar sh2 = profileData[i+1].second();
                    
                    // Linear interpolation formula
                    return sh1 + (sh2 - sh1) * (z - z1) / (z2 - z1);
                }
            }
            
            // Fallback - return last value
            return profileData.last().second();
        };

