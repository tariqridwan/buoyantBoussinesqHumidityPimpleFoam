FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    earth
    {
        type            atmAlphatkWallFunction;
        Pr              constant 0.7;
        Prt             constant 0.7;
        z0              constant 0.003;
        value           uniform 0;
    }
    cblTop
    {
        type            calculated;
        value           uniform 0;
    }
    cblLeft
    {
        type            cyclic;
    }
    cblRight
    {
        type            cyclic;
    }
    cblFront
    {
        type            cyclic;
    }
    cblBack
    {
        type            cyclic;
    }
}


