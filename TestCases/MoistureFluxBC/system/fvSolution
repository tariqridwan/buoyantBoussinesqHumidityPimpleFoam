FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-06;
        relTol          0;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

      "(U|T|k|sh)"
    {
        solver         PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0;
    }

    "(U|T|k|sh)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor yes;
    nOuterCorrectors 1000;
    nCorrectors     3;
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       0;
 
    residualControl
    {
        U
        {
            tolerance  1e-5;
            relTol      0;
        }
        T
        {
            tolerance  1e-5;
            relTol      0;
        }
        sh
        {
            tolerance  1e-5;
            relTol      0;
        }
        p_rgh
        {
            tolerance  5e-5;
            relTol      0;
        }
     }
}

relaxationFactors
{
    fields
    {
        p_rgh           0.3;
    }
    equations
    {
        U               0.7;
        T               0.7;
        "(k|sh)" 0.7;
    }
}


